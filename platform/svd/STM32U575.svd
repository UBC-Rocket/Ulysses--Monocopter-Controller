                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>trigger of CSTART control enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
